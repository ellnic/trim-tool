#!/usr/bin/env bash
# trim_tool.sh
# A whiptail TUI for SSD/NVMe TRIM discovery, status, scheduling, and health checks.
#
# Safety policy (per user request):
# - Explicitly detects rotational (spinning rust) disks.
# - Explicitly detects ZFS involvement (mounted zfs datasets or zfs_member devices).
# - This tool CAN manage scheduled TRIM (systemd fstrim.timer) on non-ZFS systems.
# - If ZFS is detected, scheduled TRIM management is BLOCKED on purpose (ZFS safety gate).
#   Rationale: avoid unintended TRIM/discard effects on ZFS-backed storage for data protection.
#
# Notes:
# - Designed for Debian/Ubuntu-family and most systemd distros, but tries to degrade gracefully.
# - All confirmation prompts default to NO (via --defaultno).
# - Whiptail list selection is used wherever practical (including multi-select checklists).
#
# Dependencies (auto-detected): whiptail, lsblk, findmnt, fstrim, systemctl (optional), smartctl (optional)

set -u
set -o pipefail
# IMPORTANT: No 'set -e' here (avoids whiptail cancel/esc hard exits).
# IMPORTANT: This tool is non-destructive by default.
# All confirmation dialogs explicitly default to NO via --defaultno.


APP_NAME="Trim Tool"
APP_VER="0.10.0-alpha"

TMP_DIR=""
REPORT_FILE=""
SELECTED_MNTS=()
SELECTED_DEVS=()

# UI sizing (narrower windows)
UI_W=74
UI_W_WIDE=78
UI_H=18

cleanup() {
  [[ -n "${TMP_DIR:-}" && -d "${TMP_DIR:-}" ]] && rm -rf "$TMP_DIR" || true
}
trap cleanup EXIT

need_cmd() { command -v "$1" >/dev/null 2>&1; }

die() {
  local msg="$1"
  whiptail --title "$APP_NAME" --msgbox "$msg" 12 "$UI_W_WIDE"
  exit 1
}

# ---------------- UI helpers ----------------

ui_msg() {
  local title="${1:-$APP_NAME}"
  local msg="${2:-}"
  whiptail --title "$title" --msgbox "$msg" 20 "$UI_W_WIDE"
}

ui_yesno_default_no() {
  local title="$1"
  local msg="$2"
  # Always default to NO
  whiptail --title "$title" --defaultno --yesno "$msg" "$UI_H" "$UI_W_WIDE"
}

ui_menu() {
  local title="$1"
  local prompt="$2"
  shift 2
  whiptail --title "$title" --menu "$prompt" 18 "$UI_W_WIDE" 9 "$@" 3>&1 1>&2 2>&3
}

ui_checklist() {
  local title="$1"
  local prompt="$2"
  shift 2
  whiptail --title "$title" --checklist "$prompt" 20 "$UI_W_WIDE" 10 "$@" 3>&1 1>&2 2>&3
}

ui_inputbox() {
  local title="$1"
  local prompt="$2"
  local default="${3:-}"
  whiptail --title "$title" --inputbox "$prompt" 12 "$UI_W_WIDE" "$default" 3>&1 1>&2 2>&3
}

ui_radiolist() {
  local title="$1"
  local prompt="$2"
  shift 2
  whiptail --title "$title" --radiolist "$prompt" 18 "$UI_W_WIDE" 9 "$@" 3>&1 1>&2 2>&3
}

# ---------------- System detection ----------------

detect_os() {
  local pretty="Unknown Linux"
  local id="unknown"
  local ver="unknown"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    pretty="${PRETTY_NAME:-$pretty}"
    id="${ID:-$id}"
    ver="${VERSION_ID:-$ver}"
  fi
  echo "$pretty|$id|$ver"
}

has_systemd() {
  need_cmd systemctl && systemctl >/dev/null 2>&1
}

systemd_unit_state() {
  local unit="$1"
  if ! has_systemd; then
    echo "n/a"
    return 0
  fi
  local is_enabled is_active
  is_enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
  is_active="$(systemctl is-active "$unit" 2>/dev/null || true)"
  echo "enabled=$is_enabled active=$is_active"
}

# ---------------- Custom Trim Tool timer (safe with ZFS) ----------------
# Why:
# - The stock systemd fstrim.timer runs fstrim --all and could act on any mounted filesystem
#   that supports FITRIM. While ZFS typically doesn't respond to fstrim, we keep a strict
#   safety stance when ZFS is present.
# - This tool can optionally create its own systemd units that run fstrim ONLY on an explicit
#   list of non-ZFS mountpoints selected in the UI.

CUSTOM_NAME="trim-tool"
CUSTOM_DIR="/etc/trim-tool"
CUSTOM_MOUNTS_FILE="$CUSTOM_DIR/mounts.conf"

custom_unit_timer="${CUSTOM_NAME}.timer"
custom_unit_service="${CUSTOM_NAME}.service"

custom_units_installed() {
  has_systemd || return 1
  systemctl cat "$custom_unit_timer" >/dev/null 2>&1 && return 0
  return 1
}

custom_write_mounts() {
  # args: mountpoints...
  mkdir -p "$CUSTOM_DIR"
  : > "$CUSTOM_MOUNTS_FILE"
  echo "# Trim Tool mount list (one mountpoint per line). Generated by Trim Tool." >> "$CUSTOM_MOUNTS_FILE"
  local m
  for m in "$@"; do
    echo "$m" >> "$CUSTOM_MOUNTS_FILE"
  done
}

custom_install_units() {
  # args: OnCalendar string
  local oncal="$1"
  mkdir -p "$CUSTOM_DIR"

  cat > "/etc/systemd/system/${custom_unit_service}" <<'EOF'
[Unit]
Description=Trim Tool: fstrim selected mountpoints
Documentation=man:fstrim(8)
After=local-fs.target
ConditionPathExists=/etc/trim-tool/mounts.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/trim-tool-run.sh
EOF

  cat > "/etc/systemd/system/${custom_unit_timer}" <<EOF
[Unit]
Description=Trim Tool: scheduled TRIM for selected mountpoints

[Timer]
OnCalendar=$oncal
Persistent=true

[Install]
WantedBy=timers.target
EOF

  cat > "/usr/local/sbin/trim-tool-run.sh" <<'EOF'
#!/usr/bin/env bash
set -u
set -o pipefail
# No set -e: fail one mount, continue and report.
MOUNTS_FILE="/etc/trim-tool/mounts.conf"
[[ -r "$MOUNTS_FILE" ]] || exit 0
need_cmd(){ command -v "$1" >/dev/null 2>&1; }
need_cmd fstrim || exit 0

rc=0
while IFS= read -r m; do
  [[ -z "$m" ]] && continue
  [[ "$m" =~ ^[[:space:]]*# ]] && continue
  if mountpoint -q "$m" 2>/dev/null; then
    fstrim -v "$m" || rc=1
  else
    rc=1
  fi
done < "$MOUNTS_FILE"
exit "$rc"
EOF
  chmod +x /usr/local/sbin/trim-tool-run.sh

  systemctl daemon-reload
}

custom_enable_now() { systemctl enable --now "$custom_unit_timer"; }
custom_disable_now() { systemctl disable --now "$custom_unit_timer"; }

custom_status() {
  {
    echo "Unit state: $(systemd_unit_state "$custom_unit_timer")"
    echo ""
    echo "Mount list: $CUSTOM_MOUNTS_FILE"
    if [[ -r "$CUSTOM_MOUNTS_FILE" ]]; then
      echo "---"
      cat "$CUSTOM_MOUNTS_FILE" 2>/dev/null || true
      echo "---"
    else
      echo "(no mount list configured yet)"
    fi
    echo ""
    systemctl list-timers --all | awk 'BEGIN{p=0} $1 ~ /trim-tool/ {p=1} p{print}' || true
  } | sed 's/\t/  /g'
}

# ---------------- ZFS detection & safety gates ----------------

zfs_mounts_present() {
  need_cmd findmnt || return 1
  # Any mounted ZFS datasets?
  findmnt -rn -t zfs >/dev/null 2>&1
}

zfs_member_present() {
  need_cmd lsblk || return 1
  # Any block device/partition with FSTYPE zfs_member?
  lsblk -f -n -o FSTYPE 2>/dev/null | awk '{print $1}' | grep -qx "zfs_member"
}

zfs_present() {
  zfs_mounts_present && return 0
  zfs_member_present && return 0
  return 1
}

zfs_safety_banner() {
  cat <<EOF
ZFS detected on this system.

Normally, this tool can enable/disable/configure scheduled TRIM via systemd (fstrim.timer).
However, the ZFS safety gate is active, so scheduled TRIM changes are BLOCKED on purpose:
- enable/disable/configure fstrim.timer  (blocked due to ZFS)
- any automation that could affect ZFS datasets (blocked due to ZFS)

You can still safely use:
- detection and status screens
- SMART/NVMe health checks (read-only)
- TRIM dry-run / TRIM now on explicitly selected non-ZFS mounts (ext4/xfs/btrfs/f2fs)
EOF
}

# ---------------- Drive / FS detection ----------------

# list block devices (disks only) with key attrs
# columns: NAME TYPE SIZE ROTA MODEL TRAN SERIAL
list_disks() {
  lsblk -d -n -o NAME,TYPE,SIZE,ROTA,MODEL,TRAN,SERIAL 2>/dev/null | awk '$2=="disk"{print}'
}

is_rotational() {
  local name="$1"
  local rota
  rota="$(lsblk -d -n -o ROTA "/dev/$name" 2>/dev/null | head -n1 | tr -d ' ')"
  [[ "$rota" == "1" ]]
}

# Determine "is SSD/NVMe" heuristically:
# - ROTA == 0 indicates non-rotational
# - TRAN == nvme indicates NVMe
is_ssd_like() {
  local name="$1"
  local rota tran
  rota="$(lsblk -d -n -o ROTA "/dev/$name" 2>/dev/null | head -n1 | tr -d ' ')"
  tran="$(lsblk -d -n -o TRAN "/dev/$name" 2>/dev/null | head -n1 | tr -d ' ')"
  [[ "$rota" == "0" || "$tran" == "nvme" ]]
}

# TRIM support by device: lsblk -D gives DISC-MAX / DISC-GRAN. If DISC-MAX > 0 then supports discard.
dev_supports_trim() {
  local name="$1"
  local disc_max
  disc_max="$(lsblk -D -n -o DISC-MAX "/dev/$name" 2>/dev/null | head -n1 | tr -d ' ')"
  [[ -n "$disc_max" && "$disc_max" != "0B" && "$disc_max" != "0" ]]
}

# Is a disk associated with ZFS? (zfs_member on any child partition)
disk_is_zfs_member() {
  local name="$1"
  # Look at children fstypes
  lsblk -n -o FSTYPE "/dev/$name" 2>/dev/null | awk '{print $1}' | grep -qx "zfs_member"
}

# Mounted filesystems we can trim: ext4, xfs, btrfs, f2fs
list_mounted_targets() {
  findmnt -rn -o TARGET,SOURCE,FSTYPE,OPTIONS 2>/dev/null | while read -r tgt src fstype opts; do
    [[ -z "$tgt" || -z "$fstype" ]] && continue
    case "$fstype" in
      ext4|xfs|btrfs|f2fs) ;;
      *) continue ;;
    esac
    case "$tgt" in
      /proc*|/sys*|/dev*|/run*|/snap*|/var/lib/snapd/*) continue ;;
    esac
    echo "$tgt|$src|$fstype|$opts"
  done
}

mount_has_discard() {
  local opts="$1"
  [[ "$opts" == *"discard"* ]]
}

# ---------------- Health checks ----------------

smartctl_summary_for_dev() {
  local dev="$1"
  if ! need_cmd smartctl; then
    echo "smartctl not installed. Install smartmontools for health details."
    return 0
  fi

  local out
  out="$(smartctl -a "$dev" 2>/dev/null || true)"

  if [[ -z "$out" ]]; then
    echo "No SMART data (permission? device unsupported?). Try: sudo smartctl -a $dev"
    return 0
  fi

  local nvme_pct_used nvme_avail_spare nvme_media_errors nvme_unsafe
  nvme_pct_used="$(echo "$out" | awk -F: '/Percentage Used/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')"
  nvme_avail_spare="$(echo "$out" | awk -F: '/Available Spare/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')"
  nvme_media_errors="$(echo "$out" | awk -F: '/Media and Data Integrity Errors/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')"
  nvme_unsafe="$(echo "$out" | awk -F: '/Unsafe Shutdowns/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')"

  local sata_realloc sata_pending sata_uecc sata_poweron
  sata_realloc="$(echo "$out" | awk '$1 ~ /^5$/ {print $10; exit}')"
  sata_pending="$(echo "$out" | awk '$1 ~ /^197$/ {print $10; exit}')"
  sata_uecc="$(echo "$out" | awk '$1 ~ /^198$/ {print $10; exit}')"
  sata_poweron="$(echo "$out" | awk '$1 ~ /^9$/ {print $10; exit}')"

  local lines=()
  lines+=("Device: $dev")

  if echo "$out" | grep -qi "NVMe"; then
    [[ -n "$nvme_pct_used" ]] && lines+=("NVMe Percentage Used: $nvme_pct_used")
    [[ -n "$nvme_avail_spare" ]] && lines+=("NVMe Available Spare: $nvme_avail_spare")
    [[ -n "$nvme_media_errors" ]] && lines+=("NVMe Media/Data Errors: $nvme_media_errors")
    [[ -n "$nvme_unsafe" ]] && lines+=("NVMe Unsafe Shutdowns: $nvme_unsafe")
  else
    if echo "$out" | grep -qi "SMART overall-health"; then
      lines+=("SMART Overall: $(echo "$out" | awk -F: '/SMART overall-health/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')")
    elif echo "$out" | grep -qi "SMART Health Status"; then
      lines+=("SMART Health: $(echo "$out" | awk -F: '/SMART Health Status/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')")
    fi
    [[ -n "$sata_realloc" ]] && lines+=("Reallocated Sectors (5): $sata_realloc")
    [[ -n "$sata_pending" ]] && lines+=("Pending Sectors (197): $sata_pending")
    [[ -n "$sata_uecc" ]] && lines+=("Uncorrectable (198): $sata_uecc")
    [[ -n "$sata_poweron" ]] && lines+=("Power-On Hours (9): $sata_poweron")
  fi

  printf "%s\n" "${lines[@]}"
}

# ---------------- TRIM operations ----------------

trim_dry_run() {
  local mnt="$1"
  if ! need_cmd fstrim; then
    echo "fstrim not installed."
    return 0
  fi
  fstrim -n -v "$mnt" 2>/dev/null | tail -n1
}

trim_run_now() {
  local mnt="$1"
  if ! need_cmd fstrim; then
    echo "fstrim not installed."
    return 1
  fi
  fstrim -v "$mnt" 2>&1
}

# ---------------- Scheduling management (systemd) ----------------

ensure_root_or_sudo_note() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    ui_msg "$APP_NAME" "Heads up: actions that change system configuration or run TRIM may require root.\n\nIf something fails with permissions, re-run with sudo:\n  sudo $0"
    return 0
  fi
  return 0
}

systemd_enable_trim() {
  has_systemd || return 1
  systemctl enable --now fstrim.timer
}

systemd_disable_trim() {
  has_systemd || return 1
  systemctl disable --now fstrim.timer
}

systemd_set_timer_schedule() {
  local oncal="$1"
  has_systemd || return 1

  local dir="/etc/systemd/system/fstrim.timer.d"
  mkdir -p "$dir"
  cat > "$dir/override.conf" <<EOF
[Timer]
OnCalendar=
OnCalendar=$oncal
Persistent=true
EOF

  systemctl daemon-reload
  systemctl restart fstrim.timer
}

systemd_show_timer_details() {
  has_systemd || { echo "systemd not detected."; return 0; }
  {
    echo "Unit state: $(systemd_unit_state fstrim.timer)"
    echo ""
    systemctl cat fstrim.timer 2>/dev/null || true
    echo ""
    systemctl list-timers --all | awk 'BEGIN{p=0} $1 ~ /fstrim/ {p=1} p{print}' || true
  } | sed 's/\t/  /g'
}

# ---------------- Recommendations ----------------

recommendations_report() {
  local os_pretty="$1"
  local timer_state="$2"

  echo "$APP_NAME $APP_VER"
  echo "Generated: $(date -Is 2>/dev/null || date)"
  echo "OS: $os_pretty"
  echo "Init: $([[ $(has_systemd; echo $?) -eq 0 ]] && echo systemd || echo unknown/non-systemd)"
  echo ""

  if zfs_present; then
    echo "== ZFS safety gate =="
    zfs_safety_banner
    echo ""
  fi

  echo "== Scheduling status =="
  if has_systemd; then
    echo "fstrim.timer: $timer_state"
    echo ""
    if zfs_present; then
      echo "Note: Scheduling changes are blocked specifically because ZFS was detected (safety gate)."
    else
      echo "Tip: Weekly scheduled TRIM via fstrim.timer is usually the safest default."
      echo "Tip: Continuous mount option 'discard' can be OK, but may reduce performance on some workloads."
    fi
  else
    echo "systemd not detected, cannot manage fstrim.timer."
    echo "Tip: Consider a weekly cron job that runs: fstrim -av"
  fi
  echo ""

  echo "== Mounted filesystems (trim candidates, non-ZFS) =="
  local any=0
  while IFS="|" read -r tgt src fstype opts; do
    any=1
    local disc="no"
    mount_has_discard "$opts" && disc="yes"
    printf " - %s (%s) source=%s discard_mount_opt=%s\n" "$tgt" "$fstype" "$src" "$disc"
  done < <(list_mounted_targets)
  [[ "$any" -eq 0 ]] && echo " (none found: ext4/xfs/btrfs/f2fs mounts)"

  echo ""
  echo "== Drives (SSD/NVMe, HDD, discard, ZFS membership) =="
  while read -r name type size rota model tran serial; do
    local kind="HDD (rotational)"
    is_ssd_like "$name" && kind="SSD/NVMe"
    local trim="no"
    dev_supports_trim "$name" && trim="yes"
    local zfs="no"
    disk_is_zfs_member "$name" && zfs="yes"
    printf " - /dev/%s size=%s kind=%s discard_supported=%s zfs_member=%s model=%s\n" \
      "$name" "$size" "$kind" "$trim" "$zfs" "${model:-?}"
  done < <(list_disks)

  echo ""
  echo "== Suggested next steps =="
  echo "1) Prefer scheduled TRIM (weekly) unless you have a specific reason for continuous discard."
  echo "2) If you use LUKS or LVM, make sure discard is configured appropriately (security/performance tradeoffs)."
  echo "3) Run a dry-run estimate on your key mounts, then a real TRIM if needed."
  echo "4) Check SMART health if smartctl is available."
  if zfs_present; then
    echo ""
    echo "ZFS note: This tool intentionally avoids TRIM scheduling actions on systems with ZFS."
  fi
}

# ---------------- Selection builders ----------------

build_mount_checklist_items() {
  local idx=0
  while IFS="|" read -r tgt src fstype opts; do
    idx=$((idx+1))
    local tag="$tgt"
    local desc="$fstype src=$src opts=$(echo "$opts" | cut -c1-34)"
    echo "$tag" "$desc" "OFF"
  done < <(list_mounted_targets)
  [[ "$idx" -eq 0 ]] && return 1 || return 0
}

build_drive_checklist_items() {
  local idx=0
  while read -r name type size rota model tran serial; do
    idx=$((idx+1))
    local kind="HDD"
    is_ssd_like "$name" && kind="SSD/NVMe"
    local trim="no"
    dev_supports_trim "$name" && trim="yes"
    local zfs="no"
    disk_is_zfs_member "$name" && zfs="yes"
    local tag="/dev/$name"
    local extra=""
    [[ "$zfs" == "yes" ]] && extra=" ZFS"
    [[ "$(is_rotational "$name"; echo $?)" -eq 0 ]] && extra="${extra} HDD"
    local desc="$size $kind disc=$trim${extra}"
    echo "$tag" "$desc" "OFF"
  done < <(list_disks)
  [[ "$idx" -eq 0 ]] && return 1 || return 0
}

# ---------------- Actions ----------------

action_show_overview() {
  local os_pretty os_id os_ver
  IFS="|" read -r os_pretty os_id os_ver < <(detect_os)

  local timer="n/a"
  has_systemd && timer="$(systemd_unit_state fstrim.timer)"

  local zfs="no"
  zfs_present && zfs="yes"

  local msg=""
  msg+="OS: $os_pretty\n"
  msg+="Init: $([[ $(has_systemd; echo $?) -eq 0 ]] && echo systemd || echo unknown/non-systemd)\n"
  msg+="ZFS detected: $zfs\n\n"
  msg+="fstrim present: $([[ $(need_cmd fstrim; echo $?) -eq 0 ]] && echo yes || echo no)\n"
  msg+="smartctl present: $([[ $(need_cmd smartctl; echo $?) -eq 0 ]] && echo yes || echo no)\n\n"
  msg+="fstrim.timer: $timer\n\n"

  msg+="Disk summary:\n"
  local total=0 ssd=0 hdd=0 zfsd=0
  while read -r name type size rota model tran serial; do
    total=$((total+1))
    if is_ssd_like "$name"; then ssd=$((ssd+1)); else hdd=$((hdd+1)); fi
    disk_is_zfs_member "$name" && zfsd=$((zfsd+1))
  done < <(list_disks)
  msg+="  total: $total\n  SSD/NVMe: $ssd\n  HDD: $hdd\n  ZFS member disks: $zfsd\n\n"

  if zfs_present; then
    msg+="ZFS safety gate is active.\n"
    msg+="This tool will not manage scheduled TRIM.\n"
  else
    msg+="Tip: Use 'Recommendations' for a full report.\n"
  fi
  ui_msg "$APP_NAME" "$msg"
}

action_select_mounts() {
  local items
  items="$(build_mount_checklist_items)" || {
    ui_msg "$APP_NAME" "No mounted ext4/xfs/btrfs/f2fs targets found."
    return 1
  }

  local out
  out=$(ui_checklist "$APP_NAME" "Select mountpoints (space to toggle):" $items) || return 1
  # shellcheck disable=SC2206
  SELECTED_MNTS=($out)
  return 0
}

action_select_devs() {
  local items
  items="$(build_drive_checklist_items)" || {
    ui_msg "$APP_NAME" "No disks found."
    return 1
  }

  local out
  out=$(ui_checklist "$APP_NAME" "Select drives for SMART/NVMe health:" $items) || return 1
  # shellcheck disable=SC2206
  SELECTED_DEVS=($out)
  return 0
}

action_trim_dryrun() {
  if zfs_present; then
    ui_msg "$APP_NAME" "$(zfs_safety_banner)\n\nDry-run is allowed for non-ZFS mounts only."
  fi

  action_select_mounts || return 1
  [[ "${#SELECTED_MNTS[@]}" -eq 0 ]] && return 0

  local buf=""
  for m in "${SELECTED_MNTS[@]}"; do
    buf+="== $m ==\n"
    buf+="$(trim_dry_run "$m")\n\n"
  done
  ui_msg "$APP_NAME" "$buf"
}

action_trim_run() {
  ensure_root_or_sudo_note

  if zfs_present; then
    ui_msg "$APP_NAME" "$(zfs_safety_banner)\n\nTRIM is allowed only on selected non-ZFS mounts."
  fi

  action_select_mounts || return 1
  [[ "${#SELECTED_MNTS[@]}" -eq 0 ]] && return 0

  if ! ui_yesno_default_no "$APP_NAME" "Run TRIM now on selected mountpoints?\n\nSelected:\n$(printf ' - %s\n' "${SELECTED_MNTS[@]}")"; then
    return 0
  fi

  local buf=""
  for m in "${SELECTED_MNTS[@]}"; do
    buf+="== TRIM $m ==\n"
    buf+="$(trim_run_now "$m")\n\n"
  done
  ui_msg "$APP_NAME" "$buf"
}

action_timer_status() {
  if ! has_systemd; then
    ui_msg "$APP_NAME" "systemd not detected. Cannot manage fstrim.timer.\n\nYou can still run TRIM manually on selected mounts."
    return 0
  fi

  local details
  details="$(systemd_show_timer_details)"
  if zfs_present; then
    details+="\n\n---\nZFS safety gate: scheduling changes are blocked (this is why)."
  fi
  ui_msg "$APP_NAME" "$details"
}

action_timer_enable_disable() {
  if zfs_present; then
    ui_msg "$APP_NAME" "$(zfs_safety_banner)\n\nScheduling is blocked."
    return 0
  fi

  if ! has_systemd; then
    ui_msg "$APP_NAME" "systemd not detected. Cannot enable/disable fstrim.timer."
    return 0
  fi

  ensure_root_or_sudo_note

  local choice
  choice=$(ui_menu "$APP_NAME" "Scheduled TRIM (systemd)" \
    "enable"  "Enable + start fstrim.timer" \
    "disable" "Disable + stop fstrim.timer" \
    "back"    "Back") || return 1

  case "$choice" in
    enable)
      if ui_yesno_default_no "$APP_NAME" "Enable and start fstrim.timer now?"; then
        local out
        out="$(systemd_enable_trim 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    disable)
      if ui_yesno_default_no "$APP_NAME" "Disable and stop fstrim.timer now?"; then
        local out
        out="$(systemd_disable_trim 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    back) ;;
  esac
}

action_timer_configure() {
  if zfs_present; then
    ui_msg "$APP_NAME" "$(zfs_safety_banner)\n\nScheduling is blocked."
    return 0
  fi

  if ! has_systemd; then
    ui_msg "$APP_NAME" "systemd not detected. Cannot configure fstrim.timer schedule."
    return 0
  fi

  ensure_root_or_sudo_note

  local choice
  choice=$(ui_radiolist "$APP_NAME" "Choose a schedule (OnCalendar):" \
    "weekly" "Weekly (recommended)" "ON" \
    "daily"  "Daily" "OFF" \
    "custom" "Custom OnCalendar" "OFF" \
    "back"   "Back" "OFF") || return 1

  case "$choice" in
    weekly)
      if ui_yesno_default_no "$APP_NAME" "Apply schedule: weekly ?"; then
        local out
        out="$(systemd_set_timer_schedule "weekly" 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    daily)
      if ui_yesno_default_no "$APP_NAME" "Apply schedule: daily ?"; then
        local out
        out="$(systemd_set_timer_schedule "daily" 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    custom)
      local oncal
      oncal="$(ui_inputbox "$APP_NAME" "Enter OnCalendar value:" "Sun *-*-* 03:00:00")" || return 1
      if ui_yesno_default_no "$APP_NAME" "Apply custom OnCalendar:\n\n$oncal"; then
        local out
        out="$(systemd_set_timer_schedule "$oncal" 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    back) ;;
  esac
}

action_health_checks() {
  ensure_root_or_sudo_note
  action_select_devs || return 1
  [[ "${#SELECTED_DEVS[@]}" -eq 0 ]] && return 0

  local buf=""
  for d in "${SELECTED_DEVS[@]}"; do
    buf+="$(smartctl_summary_for_dev "$d")\n\n"
  done
  ui_msg "$APP_NAME" "$buf"
}

action_recommendations() {
  local os_pretty os_id os_ver
  IFS="|" read -r os_pretty os_id os_ver < <(detect_os)

  local timer_state="n/a"
  has_systemd && timer_state="$(systemd_unit_state fstrim.timer)"

  local rep
  rep="$(recommendations_report "$os_pretty" "$timer_state")"
  ui_msg "$APP_NAME" "$rep"

  echo "$rep" > "$REPORT_FILE"
}

action_export_report() {
  if [[ ! -s "$REPORT_FILE" ]]; then
    ui_msg "$APP_NAME" "No report generated yet.\n\nRun 'Recommendations' first."
    return 0
  fi
  ui_msg "$APP_NAME" "Report saved at:\n$REPORT_FILE"
}

action_mount_trim_flags() {
  local buf="== Mount TRIM visibility (non-ZFS) ==\n\n"
  local any=0
  while IFS="|" read -r tgt src fstype opts; do
    any=1
    local disc="no"
    mount_has_discard "$opts" && disc="yes"
    buf+="Mount: $tgt\nFS: $fstype\nSource: $src\n"
    buf+="discard mount option: $disc\n"
    buf+="dry-run: $(trim_dry_run "$tgt")\n\n"
  done < <(list_mounted_targets)

  [[ "$any" -eq 0 ]] && buf+="No mounted ext4/xfs/btrfs/f2fs targets found.\n"
  if zfs_present; then
    buf+="\n---\nZFS detected: this tool will not manage TRIM scheduling.\n"
  fi
  ui_msg "$APP_NAME" "$buf"
}

action_custom_timer_menu() {
  if ! has_systemd; then
    ui_msg "$APP_NAME" "systemd not detected.\n\nTrim Tool cannot create a custom timer.\n\nYou can still run manual TRIM (selected mounts) and view health info."
    return 0
  fi

  ensure_root_or_sudo_note

  local sub
  sub=$(ui_menu "$APP_NAME" "Custom scheduled TRIM (Trim Tool)" \
    "pick"    "Select mountpoints for custom timer" \
    "install" "Install/update custom timer + schedule" \
    "enable"  "Enable + start custom timer" \
    "disable" "Disable + stop custom timer" \
    "status"  "Show custom timer status" \
    "back"    "Back") || return 0

  case "$sub" in
    pick)
      action_select_mounts || return 0
      if [[ "${#SELECTED_MNTS[@]}" -eq 0 ]]; then
        ui_msg "$APP_NAME" "No mountpoints selected."
        return 0
      fi
      if ui_yesno_default_no "$APP_NAME" "Write these mountpoints to:\n$CUSTOM_MOUNTS_FILE\n\n$(printf ' - %s\n' "${SELECTED_MNTS[@]}")"; then
        if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
          ui_msg "$APP_NAME" "Permission needed to write $CUSTOM_MOUNTS_FILE.\n\nRe-run with sudo to apply."
          return 0
        fi
        custom_write_mounts "${SELECTED_MNTS[@]}"
        ui_msg "$APP_NAME" "Saved mount list."
      fi
      ;;
    install)
      local choice
      choice="$(ui_radiolist "$APP_NAME" "Choose schedule (OnCalendar) for custom timer:" \
        "weekly" "Weekly (recommended)" "ON" \
        "daily"  "Daily" "OFF" \
        "custom" "Custom value" "OFF" \
        "back"   "Back" "OFF")" || return 0
      case "$choice" in
        weekly|daily)
          if ui_yesno_default_no "$APP_NAME" "Install/update custom timer with schedule: $choice ?\n\nSafe with ZFS: trims only selected mountpoints."; then
            if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
              ui_msg "$APP_NAME" "Permission needed.\n\nRe-run with sudo to install systemd units."
              return 0
            fi
            local out
            out="$(custom_install_units "$choice" 2>&1 || true)"
            ui_msg "$APP_NAME" "Result:\n$out"
          fi
          ;;
        custom)
          local val
          val="$(ui_inputbox "$APP_NAME" "Enter systemd OnCalendar value:" "Sun *-*-* 03:00:00")" || return 0
          if ui_yesno_default_no "$APP_NAME" "Install/update custom timer with:\n\n$val\n\nSafe with ZFS: trims only selected mountpoints."; then
            if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
              ui_msg "$APP_NAME" "Permission needed.\n\nRe-run with sudo to install systemd units."
              return 0
            fi
            local out
            out="$(custom_install_units "$val" 2>&1 || true)"
            ui_msg "$APP_NAME" "Result:\n$out"
          fi
          ;;
        back) ;;
      esac
      ;;
    enable)
      if ui_yesno_default_no "$APP_NAME" "Enable and start the custom timer now?"; then
        if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
          ui_msg "$APP_NAME" "Permission needed.\n\nRe-run with sudo."
          return 0
        fi
        local out
        out="$(custom_enable_now 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    disable)
      if ui_yesno_default_no "$APP_NAME" "Disable and stop the custom timer now?"; then
        if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
          ui_msg "$APP_NAME" "Permission needed.\n\nRe-run with sudo."
          return 0
        fi
        local out
        out="$(custom_disable_now 2>&1 || true)"
        ui_msg "$APP_NAME" "Result:\n$out"
      fi
      ;;
    status)
      ui_msg "$APP_NAME" "$(custom_status)"
      ;;
    back) ;;
  esac
}

# ---------------- Main ----------------

main() {
  TMP_DIR="$(mktemp -d -t trim_tui.XXXXXX)"
  REPORT_FILE="$TMP_DIR/trim_report.txt"

  need_cmd whiptail || die "whiptail is required.\n\nInstall (Debian/Ubuntu):\n  sudo apt install whiptail"
  need_cmd lsblk   || die "lsblk is required.\n\nInstall util-linux."
  need_cmd findmnt || die "findmnt is required.\n\nInstall util-linux."

  while true; do
    local choice
    choice=$(ui_menu "$APP_NAME" "TRIM + SSD/NVMe helper (defaults NO)" \
      "overview" "System overview (SSD/HDD/ZFS)" \
      "mounts"   "Mounts: discard + dry-run view" \
      "dryrun"   "TRIM dry-run (selected mounts)" \
      "trimnow"  "Run TRIM now (selected mounts)" \
      "timer"    "Scheduled TRIM (status / enable / timing)" \
      "health"   "Drive health summary (SMART/NVMe)" \
      "reco"     "Recommendations (save report)" \
      "export"   "Show path to saved report" \
      "quit"     "Quit") || exit 0

    case "$choice" in
      overview) action_show_overview ;;
      mounts)   action_mount_trim_flags ;;
      dryrun)   action_trim_dryrun ;;
      trimnow)  action_trim_run ;;
      timer)
        # sub-menu (keeps main menu thinner)
        local sub
        sub=$(ui_menu "$APP_NAME" "Scheduled TRIM (systemd)"           "status" "Show timer details"           "onoff"  "Enable or disable (stock fstrim.timer)"           "timing" "Configure timing (stock fstrim.timer)"           "custom" "Custom timer (safe with ZFS)"           "back"   "Back") || continue
        case "$sub" in
          status) action_timer_status ;;
          onoff)  action_timer_enable_disable ;;
          timing) action_timer_configure ;;
          custom) action_custom_timer_menu ;;
          back)   ;;
        esac
        ;;
      health) action_health_checks ;;
      reco)   action_recommendations ;;
      export) action_export_report ;;
      quit)   exit 0 ;;
    esac
  done
}

main "$@"
